module(
    name = "cocos4_rust",
    version = "0.1.0",
    compatibility_level = 1,
)

# Bazel rules for Rust — see https://github.com/bazelbuild/rules_rust
bazel_dep(name = "rules_rust", version = "0.61.0")
bazel_dep(name = "platforms", version = "0.0.10")
bazel_dep(name = "bazel_skylib", version = "1.7.1")

# --- crate_universe: turn Cargo.toml + Cargo.lock into Bazel deps ----------
# This makes Cargo.toml the single source of truth for EXTERNAL deps.
# The local `cocos4-rust` crate is built by the `rust_library` in BUILD.bazel
# and is NOT mirrored into @crates// — that would make cargo-bazel try to
# look it up in crates.io and fail (no local path / git / version on a
# local-only workspace package).
#
# Features live on the local rust_library rule (`crate_features` in
# BUILD.bazel). The set of optional / required features is still read
# out of Cargo.toml by `crate_universe` so the @crates//:* deps know
# which `cfg` flags to emit.
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")

crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = ["//:Cargo.toml"],
    supported_platform_triples = [
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "aarch64-apple-darwin",
    ],
)

use_repo(crate, "crates")
