module(
    name = "cocos4_rust",
    version = "0.1.0",
    compatibility_level = 1,
)

# Bazel rules for Rust — see https://github.com/bazelbuild/rules_rust
bazel_dep(name = "rules_rust", version = "0.61.0")
bazel_dep(name = "platforms", version = "0.0.10")
bazel_dep(name = "bazel_skylib", version = "1.7.1")

# --- crate_universe: turn Cargo.toml + Cargo.lock into Bazel deps ----------
# This makes Cargo.toml the single source of truth for EXTERNAL deps.
# The local `cocos4-rust` crate is built by the `rust_library` in BUILD.bazel.
#
# `crate.spec` is for registry/git deps only and has no "local path"
# attribute. The local crate is picked up transitively: because the
# root Cargo.toml is a `[workspace]` root (with itself as a member),
# `crate.from_cargo` reads the workspace's path-dependency graph, sees
# `cocos4-rust` as a local path member, and emits a `local_crate_mirror`
# at `@crates//:cocos4-rust`.
#
# `crate.annotation` then tells cargo-bazel WHICH features the local
# crate is built with. Without this, cargo-bazel defaults to the empty
# feature set, which strips the optional `boa_engine` / `serde_json`
# deps and they never appear as `@crates//:boa_engine` /
# `@crates//:serde_json` — even though they're listed in Cargo.lock.
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")

crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = ["//:Cargo.toml"],
    supported_platform_triples = [
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "aarch64-apple-darwin",
    ],
)

crate.annotation(
    crate = "cocos4-rust",
    repositories = ["crates"],
    crate_features = [
        "std",
        "gfx-empty",
        "gfx-validator",
        "gfx-wgpu",
        "gfx-agent",
        "pipeline-custom",
        "pipeline-deferred",
        "physics-2d",
        "network-real",
        "platform-real",
        "storage-disk",
        "dragon-bones",
        "spine",
        "js-bindings",
        "terrain",
        "tiled-map",
        "js-runtime-real",
    ],
)

use_repo(crate, "crates")
